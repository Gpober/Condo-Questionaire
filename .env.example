# Copy to .env.local and fill in. Supabase is REQUIRED — without the two
# NEXT_PUBLIC_SUPABASE_* vars the app throws instead of serving data.

# --- Supabase (public; safe in the browser bundle) — REQUIRED ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only; NEVER expose to the browser) ---
# Used by the Stripe webhook to credit users after payment.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (server-only; NEVER prefix with NEXT_PUBLIC) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Site URL used for Stripe redirect URLs (optional; auto-detected if unset) ---
NEXT_PUBLIC_SITE_URL=
